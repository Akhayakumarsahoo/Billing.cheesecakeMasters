generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  manager
  admin
  outlet
  storeroom
}

enum BillStatus {
  draft
  printed
  cancelled
}

enum PaymentMode {
  cash
  upi
  card
  online
}

// ─────────────────────────────────────────
// OUTLETS
// ─────────────────────────────────────────

model Outlet {
  id            String   @id @default(uuid())
  clerkUserId   String   @unique // The Clerk user ID used for the outlet POS login
  sequenceIndex Int      @unique @default(autoincrement())
  name          String
  address       String?
  stateCode     String   @db.Char(2) // e.g. "OD" for Odisha
  gstin         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Relations
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  bills          Bill[]
  billSequence   BillSequence?
  dailySettlements DailySettlement[]
  walkaways        Walkaway[]
  inventoryLinks   InventoryOutlet[]

  @@map("outlets")
}

// ─────────────────────────────────────────
// USERS
// Clerk owns auth. We store clerk_user_id
// and add role + outlet assignment on top.
// ─────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique // Clerk's user.id — set after Clerk user is created
  name        String
  email       String   @unique
  role        UserRole
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  inventoryId String?   @map("inventory_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])

  // Relations
  modifiedBills       Bill[]            @relation("BillModifiedBy")
  createdSettlements  DailySettlement[] @relation("SettlementCreatedBy")
  modifiedSettlements DailySettlement[] @relation("SettlementModifiedBy")

  purchaseInvoices    PurchaseInvoice[] @relation("PurchaseCreatedBy")
  transfersCreated    StockTransfer[]   @relation("TransferCreatedBy")
  transfersAccepted   StockTransfer[]   @relation("TransferAcceptedBy")
  transfersRejected   StockTransfer[]   @relation("TransferRejectedBy")
  wastageRecords      WastageRecord[]   @relation("WastageCreatedBy")
  stockMovements      StockMovement[]   @relation("MovementCreatedBy")

  @@map("users")
}

// ─────────────────────────────────────────
// GST SLABS
// Static lookup — seeded once, never changed.
// Slabs: 0, 5, 18, 28 (12% excluded per business decision)
// ─────────────────────────────────────────

model GstSlab {
  id    Int     @id // 0, 5, 18, 28
  rate  Decimal @db.Decimal(5, 2) // e.g. 18.00
  label String // e.g. "18%"

  // Relations
  menuItems MenuItem[]
  rawMaterials RawMaterial[]

  @@map("gst_slabs")
}

// ─────────────────────────────────────────
// MENU CATEGORIES
// Each category belongs to one outlet.
// Completely independent per outlet.
// ─────────────────────────────────────────

model MenuCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0) // controls display order in POS
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Outlet relation
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  // Relations
  menuItems MenuItem[]

  @@unique([outletId, name]) // no duplicate category names per outlet
  @@map("menu_categories")
}

// ─────────────────────────────────────────
// MENU ITEMS
// Each item belongs to one outlet and one category.
// Base price is EXCLUSIVE of GST.
// Items are never deleted — only deactivated.
// ─────────────────────────────────────────

model MenuItem {
  id        String   @id @default(uuid())
  name      String
  sku       String?
  basePrice Decimal  @db.Decimal(12, 2)
  unit      String   @default("pcs") // pcs, kg, litre, plate, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Outlet relation
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  // Category relation
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  // GST slab relation
  gstSlabId Int
  gstSlab   GstSlab @relation(fields: [gstSlabId], references: [id])

  // Relations
  billLineItems BillLineItem[]
  recipes       Recipe[]

  @@unique([outletId, sku]) // SKU unique per outlet
  @@index([outletId, isActive])
  @@map("menu_items")
}

// ─────────────────────────────────────────
// BILL NUMBER SEQUENCES
// Per-outlet counter for sequential bill numbers.
// Reset lastSeq to 0 at start of each new year.
// Use SELECT FOR UPDATE in application logic
// to prevent race conditions.
// ─────────────────────────────────────────

model BillSequence {
  outletId String @id
  outlet   Outlet @relation(fields: [outletId], references: [id])
  year     Int
  lastSeq  Int    @default(0)

  @@map("bill_sequences")
}

// ─────────────────────────────────────────
// BILLS
// One row per transaction.
// Status lifecycle: draft → printed → cancelled
// Printed bills are immutable — no field changes
// except status → cancelled and setting cancelledAt.
// Totals are always computed server-side from
// line items. Never trust client-submitted totals.
// ─────────────────────────────────────────

model Bill {
  id         String     @id @default(uuid())
  billNumber String // e.g. OTL1-2025-00042
  status     BillStatus @default(draft)

  // Optional customer details
  customerName  String?
  customerPhone String?

  // Snapshotted totals — computed via lib/gst.ts at completion
  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  totalCgst  Decimal @default(0) @db.Decimal(12, 2)
  totalSgst  Decimal @default(0) @db.Decimal(12, 2)
  totalGst   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)

  // Discount details
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  discountType   String?  // 'percentage' | 'fixed'
  discountReason String?
  discountValue  Decimal? @db.Decimal(12, 2)

  notes       String?
  completedAt DateTime? // set when status → printed
  cancelledAt DateTime? // set when status → cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  modifiedById String?
  modifiedBy   User?     @relation("BillModifiedBy", fields: [modifiedById], references: [id])

  // Outlet relation
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  // Relations
  lineItems BillLineItem[]
  payments  BillPayment[]

  @@unique([outletId, billNumber]) // bill number unique per outlet
  @@index([outletId, completedAt, status])
  @@map("bills")
}

// ─────────────────────────────────────────
// BILL LINE ITEMS
// All values are SNAPSHOTTED at billing time.
// Never recompute from menu_items after creation.
// No JOIN to MenuItem for prices — ever.
// ─────────────────────────────────────────

model BillLineItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Bill relation
  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  // Menu item reference (for audit only — never used for price lookup)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  // Snapshotted values at time of billing
  itemName  String
  sku       String?
  unit      String
  quantity  Decimal @db.Decimal(10, 3)
  basePrice Decimal @db.Decimal(12, 2) // per unit, excl. GST
  gstRate   Decimal @db.Decimal(5, 2) // e.g. 18.00

  // Computed line totals — all via lib/gst.ts
  lineBaseTotal Decimal @db.Decimal(12, 2) // basePrice × quantity
  lineGstAmount Decimal @db.Decimal(12, 2) // lineBaseTotal × gstRate / 100
  lineCgst      Decimal @db.Decimal(12, 2) // lineGstAmount / 2
  lineSgst      Decimal @db.Decimal(12, 2) // lineGstAmount / 2
  lineTotal     Decimal @db.Decimal(12, 2) // lineBaseTotal + lineGstAmount

  @@map("bill_line_items")
}

// ─────────────────────────────────────────
// BILL PAYMENTS
// Multiple rows per bill for split payment.
// SUM(amount) must equal bills.grandTotal
// before bill status can change to printed.
// Validated server-side — never trust client.
// ─────────────────────────────────────────

model BillPayment {
  id     String      @id @default(uuid())
  mode   PaymentMode
  amount Decimal     @db.Decimal(12, 2)
  paidAt DateTime    @default(now())

  // Bill relation
  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  @@map("bill_payments")
}

// ─────────────────────────────────────────
// DAILY SETTLEMENTS
// One row per daily settlement of an outlet.
// ─────────────────────────────────────────

model DailySettlement {
  id              String   @id @default(uuid())
  outletId        String
  outlet          Outlet   @relation(fields: [outletId], references: [id])
  settlementDate  DateTime // The date of the settlement (only the date part)
  
  // Opening balance of the cash box for this day
  openingCash     Decimal  @db.Decimal(12, 2)
  
  // Billed totals (calculated from printed bills completed on this day)
  billedCash      Decimal  @db.Decimal(12, 2)
  billedUpi       Decimal  @db.Decimal(12, 2)
  billedCard      Decimal  @db.Decimal(12, 2)
  
  // Actual totals entered by the outlet cashier
  actualCash      Decimal  @db.Decimal(12, 2)
  actualUpi       Decimal  @db.Decimal(12, 2)
  actualCard      Decimal  @db.Decimal(12, 2)
  
  // Cash expenses and withdrawals
  cashExpense     Decimal  @db.Decimal(12, 2)
  cashWithdraw    Decimal  @db.Decimal(12, 2)
  expenseReason   String?  @map("expense_reason")
  withdrawBy      String?  @map("withdraw_by")
  
  // Closing balance of the cash box (Opening + Actual Cash - Expense - Withdraw)
  closingCash     Decimal  @db.Decimal(12, 2)
  
  status          String   @default("active") // "active" or "cancelled"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  createdBy       User?    @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  modifiedById    String?
  modifiedBy      User?    @relation("SettlementModifiedBy", fields: [modifiedById], references: [id])

  @@unique([outletId, settlementDate])
  @@map("daily_settlements")
}

// ─────────────────────────────────────────
// WALKWAYS
// One row per customer walkaway.
// ─────────────────────────────────────────

model Walkaway {
  id             String   @id @default(uuid())
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id])
  reason         String   // E.g., "Price too high", "Item unavailable", "Long wait time", "Will return later", "Just exploring", "Other"
  customReason   String?  // Specific details if "Other" is chosen
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdByEmail String?

  @@map("walkaways")
}

// ─────────────────────────────────────────
// INVENTORIES AND STOCK MANAGEMENT
// ─────────────────────────────────────────

model Inventory {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users            User[]
  outlets          InventoryOutlet[]
  rawMaterials     RawMaterial[]
  purchaseInvoices PurchaseInvoice[]
  transfersFrom    StockTransfer[]   @relation("FromInventory")
  transfersTo      StockTransfer[]   @relation("ToInventory")
  wastageRecords   WastageRecord[]
  recipes          Recipe[]
  stockMovements   StockMovement[]

  @@map("inventories")
}

model InventoryOutlet {
  inventoryId String    @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  outletId    String    @map("outlet_id")
  outlet      Outlet    @relation(fields: [outletId], references: [id])

  @@id([inventoryId, outletId])
  @@unique([inventoryId, outletId])
  @@map("inventory_outlets")
}

model RawMaterial {
  id            String   @id @default(uuid())
  inventoryId   String   @map("inventory_id")
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  name          String
  unit          String
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  transferPrice Decimal  @map("transfer_price") @db.Decimal(12, 2)
  gstSlabId     Int      @map("gst_slab_id")
  gstSlab       GstSlab  @relation(fields: [gstSlabId], references: [id])
  currentStock  Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  lowStockAlert Decimal? @map("low_stock_alert") @db.Decimal(12, 3)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseLines  PurchaseInvoiceLine[]
  transferLines  StockTransferLine[]
  wastageLines   WastageLine[]
  recipeLines    RecipeLine[]
  stockMovements StockMovement[]

  @@unique([inventoryId, name])
  @@map("raw_materials")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String?
  address   String?
  gstin     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

enum PurchaseInvoiceStatus {
  draft
  confirmed
  cancelled
}

model PurchaseInvoice {
  id               String                @id @default(uuid())
  inventoryId      String                @map("inventory_id")
  inventory        Inventory             @relation(fields: [inventoryId], references: [id])
  supplierId       String                @map("supplier_id")
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  invoiceNumber    String                @map("invoice_number")
  invoiceDate      DateTime              @map("invoice_date") @db.Date
  status           PurchaseInvoiceStatus @default(draft)
  subtotal         Decimal               @db.Decimal(12, 2)
  totalGst         Decimal               @map("total_gst") @db.Decimal(12, 2)
  otherCharges     Decimal               @default(0) @map("other_charges") @db.Decimal(12, 2)
  otherChargesGst  Decimal               @default(0) @map("other_charges_gst") @db.Decimal(12, 2)
  grandTotal       Decimal               @map("grand_total") @db.Decimal(12, 2)
  notes            String?
  confirmedAt      DateTime?             @map("confirmed_at")
  cancelledAt      DateTime?             @map("cancelled_at")
  createdById      String                @map("created_by")
  createdBy        User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  lines PurchaseInvoiceLine[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  purchaseInvoiceId String          @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  rawMaterialId     String          @map("raw_material_id")
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  materialName      String          @map("material_name")
  unit              String
  quantity          Decimal         @db.Decimal(12, 3)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(12, 2)
  gstRate           Decimal         @map("gst_rate") @db.Decimal(5, 2)
  lineBaseTotal     Decimal         @map("line_base_total") @db.Decimal(12, 2)
  lineGstAmount     Decimal         @map("line_gst_amount") @db.Decimal(12, 2)
  lineTotal         Decimal         @map("line_total") @db.Decimal(12, 2)

  @@map("purchase_invoice_lines")
}

enum StockTransferStatus {
  draft
  pending
  accepted
  rejected
  cancelled
}

model StockTransfer {
  id              String              @id @default(uuid())
  fromInventoryId String              @map("from_inventory_id")
  fromInventory   Inventory           @relation("FromInventory", fields: [fromInventoryId], references: [id])
  toInventoryId   String              @map("to_inventory_id")
  toInventory     Inventory           @relation("ToInventory", fields: [toInventoryId], references: [id])
  status          StockTransferStatus @default(draft)
  subtotal        Decimal             @db.Decimal(12, 2)
  totalGst        Decimal             @map("total_gst") @db.Decimal(12, 2)
  otherCharges    Decimal             @default(0) @map("other_charges") @db.Decimal(12, 2)
  otherChargesGst Decimal             @default(0) @map("other_charges_gst") @db.Decimal(12, 2)
  grandTotal      Decimal             @map("grand_total") @db.Decimal(12, 2)
  notes           String?
  sentAt          DateTime?           @map("sent_at")
  acceptedAt      DateTime?           @map("accepted_at")
  rejectedAt      DateTime?           @map("rejected_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  createdById     String              @map("created_by")
  createdBy       User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  acceptedById    String?             @map("accepted_by")
  acceptedBy      User?               @relation("TransferAcceptedBy", fields: [acceptedById], references: [id])
  rejectedById    String?             @map("rejected_by")
  rejectedBy      User?               @relation("TransferRejectedBy", fields: [rejectedById], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  lines StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(uuid())
  stockTransferId String        @map("stock_transfer_id")
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
  rawMaterialId   String        @map("raw_material_id")
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  materialName    String        @map("material_name")
  unit            String
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  gstRate         Decimal       @map("gst_rate") @db.Decimal(5, 2)
  lineBaseTotal   Decimal       @map("line_base_total") @db.Decimal(12, 2)
  lineGstAmount   Decimal       @map("line_gst_amount") @db.Decimal(12, 2)
  lineTotal       Decimal       @map("line_total") @db.Decimal(12, 2)

  @@map("stock_transfer_lines")
}

enum WastageRecordStatus {
  draft
  confirmed
  cancelled
}

model WastageRecord {
  id          String              @id @default(uuid())
  inventoryId String              @map("inventory_id")
  inventory   Inventory           @relation(fields: [inventoryId], references: [id])
  status      WastageRecordStatus @default(draft)
  wastageDate DateTime            @map("wastage_date") @db.Date
  reason      String?
  notes       String?
  confirmedAt DateTime?           @map("confirmed_at")
  cancelledAt DateTime?           @map("cancelled_at")
  createdById String              @map("created_by")
  createdBy   User                @relation("WastageCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  lines WastageLine[]

  @@map("wastage_records")
}

model WastageLine {
  id              String        @id @default(uuid())
  wastageRecordId String        @map("wastage_record_id")
  wastageRecord   WastageRecord @relation(fields: [wastageRecordId], references: [id])
  rawMaterialId   String        @map("raw_material_id")
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  materialName    String        @map("material_name")
  unit            String
  quantity        Decimal       @db.Decimal(12, 3)

  @@map("wastage_lines")
}

model Recipe {
  id          String   @id @default(uuid())
  menuItemId  String   @map("menu_item_id")
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  inventoryId String   @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  lines RecipeLine[]

  @@unique([menuItemId, inventoryId])
  @@map("recipes")
}

model RecipeLine {
  id              String      @id @default(uuid())
  recipeId        String      @map("recipe_id")
  recipe          Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterialId   String      @map("raw_material_id")
  rawMaterial     RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantityPerUnit Decimal     @map("quantity_per_unit") @db.Decimal(12, 4)

  @@map("recipe_lines")
}

enum StockMovementType {
  purchase
  transfer_in
  transfer_out
  wastage
  consumption
  adjustment
}

enum StockMovementRefType {
  purchase_invoice
  stock_transfer
  wastage_record
  bill
  manual
}

model StockMovement {
  id             String               @id @default(uuid())
  inventoryId    String               @map("inventory_id")
  inventory      Inventory            @relation(fields: [inventoryId], references: [id])
  rawMaterialId  String               @map("raw_material_id")
  rawMaterial    RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  movementType   StockMovementType    @map("movement_type")
  referenceType  StockMovementRefType @map("reference_type")
  referenceId    String?              @map("reference_id")
  quantityChange Decimal              @map("quantity_change") @db.Decimal(12, 3)
  note           String?
  createdById    String               @map("created_by")
  createdBy      User                 @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now()) @map("created_at")

  @@map("stock_movements")
  @@index([rawMaterialId, createdAt])
}


